# Copier ce fichier en .env (jamais envoyé sur GitHub) puis remplir les valeurs pour docker compose.

# Base PostgreSQL du conteneur « db »
POSTGRES_PASSWORD=

# Clé de signature des sessions : 64 caractères aléatoires, par exemple avec PowerShell :
# $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_CLE=

# Compte super admin créé au premier démarrage (mot de passe : 12 caractères minimum)
SUPERADMIN_EMAIL=admin@immopilot.local
SUPERADMIN_MOT_DE_PASSE=

# Facultatif : e-mails via Brevo (SMTP & API → onglet SMTP)
EMAIL_HOTE=
EMAIL_PORT=587
EMAIL_UTILISATEUR=
EMAIL_MOT_DE_PASSE=
EMAIL_EXPEDITEUR=

# Facultatif : photos des immeubles (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
